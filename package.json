{
  "name": "bloom-ai-chat",
  "version": "1.0.1",
  "description": "Premium Offline AI Chat with Ollama",
  "main": "main.js",
  "author": "byteSize-del",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "npm run test:backend",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "installer": "node scripts/create-installer.js"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.bloom.ai-chat",
    "productName": "Bloom AI Chat",
    "artifactName": "Bloom-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".venv",
        "to": "venv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloom AI Chat",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "asarUnpack": [
      "backend/**/*"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "marked": "^17.0.5"
  }
}
